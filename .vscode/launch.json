{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Academic Planner Dashboard",
      "type": "debugpy",
      "request": "launch",
      "args": [
        "run",
        "${workspaceFolder}/streamlit/streamlit_app.py"
      ],
      "console": "integratedTerminal",
      "justMyCode": true,
      "module": "streamlit"
    },
    {
      "name": "ADSPA Daily Plan",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/agent.py",
      "args": [
        "plan"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Academic Reminder Service",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/agent.py",
      "args": ["reminder-service"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
